# Caddy는 {$DOMAIN} 환경변수로 도메인을 받아 자동으로 Let's Encrypt 인증서를 발급/갱신한다.
# 도메인이 아직 없다면 우선 서버의 공인 IP 또는 임시 도메인으로 :80만 사용하고,
# 도메인 연결 후 이 파일을 갱신해 재기동한다 (docs/DEPLOY.md 참고).

{$DOMAIN} {
	# /actuator/prometheus는 내부 Docker 네트워크(prometheus 컨테이너)에서만 스크레이프한다.
	# 외부에는 절대 노출하지 않는다 — health만 공개로 둔다.
	@actuatorPublic path /actuator/health /actuator/health/*
	@actuatorPrivate path /actuator/*
	handle @actuatorPublic {
		reverse_proxy backend:8080
	}
	handle @actuatorPrivate {
		respond 404
	}
	handle {
		reverse_proxy backend:8080
	}
}
