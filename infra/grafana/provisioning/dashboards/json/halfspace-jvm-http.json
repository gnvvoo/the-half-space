{
  "title": "The Half Space - JVM & HTTP",
  "uid": "halfspace-jvm-http",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Backend Up",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "up{job=\"backend\"}", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "HTTP Requests/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (status)", "refId": "A", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 3,
      "title": "JVM Heap Used (bytes)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "jvm_memory_used_bytes{area=\"heap\"}", "refId": "A", "legendFormat": "{{id}}" }
      ]
    },
    {
      "id": 4,
      "title": "HTTP p95 Latency (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri))", "refId": "A", "legendFormat": "{{uri}}" }
      ]
    },
    {
      "id": 5,
      "title": "Batch Job Executions (status)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "sum(increase(spring_batch_job_seconds_count[1h])) by (status)", "refId": "A", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 6,
      "title": "CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "process_cpu_usage{job=\"backend\"}", "refId": "A", "legendFormat": "process" },
        { "expr": "system_cpu_usage{job=\"backend\"}", "refId": "B", "legendFormat": "system" }
      ]
    }
  ]
}
