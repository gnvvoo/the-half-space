# 이 파일을 복사해 .env로 저장하고 실제 값을 채운다. .env는 절대 커밋하지 않는다 (.gitignore 참고).
#
# 주의: 과거 커밋(backend/src/main/resources/application.yaml)에 DB 크리덴셜 admin/1245가
# 평문으로 노출되어 있었다. 운영 DB_USERNAME/DB_PASSWORD는 반드시 새로 발급한 값으로 교체할 것
# (git 히스토리에 남은 값은 재사용 금지). docs/DEPLOY.md의 "크리덴셜 로테이션" 섹션 참고.

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=prod

# --- Backend Docker image (GHCR, 커밋 SHA 태그 — latest 금지) ---
IMAGE_TAG=<commit-sha>  # deploy.sh가 export; 수동 실행 시 지정

# --- Database (postgres) ---
DB_NAME=halfspace
DB_USERNAME=change-me
DB_PASSWORD=change-me

# --- Redis ---
REDIS_PASSWORD=

# --- JWT ---
JWT_SECRET=change-me-min-32-chars

# --- OAuth2 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 프론트 콜백 URL. 배포 도메인 확정 시 갱신 (docs/DEPLOY.md 참고)
OAUTH2_REDIRECT_URI=https://your-domain.example/oauth2/callback

# --- football-data.org ---
FOOTBALL_DATA_API_KEY=

# --- Gemini (AI 프리뷰/리뷰 생성) ---
GEMINI_API_KEY=

# --- Caddy (리버스 프록시 / 자동 HTTPS) ---
DOMAIN=your-domain.example

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=change-me
CORS_ALLOWED_ORIGINS=https://<your-frontend>.vercel.app
