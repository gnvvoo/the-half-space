# =============================================================================
# The Half-Space 운영 환경변수
#
# 사용법: VPS에서 docker-compose.prod.yml과 같은 디렉터리에 이 파일을 복사해
#   cp .env.example .env
# 실제 값을 채운다. .env는 절대 커밋하지 않는다 (.gitignore 등록됨).
#
# ⚠️ 크리덴셜 로테이션: 과거 커밋(application.yaml)에 DB 크리덴셜 admin/1245가
# 평문으로 노출된 적 있다. git 히스토리에 남은 값은 어떤 것도 재사용 금지.
# docs/DEPLOY.md의 "크리덴셜 로테이션" 섹션 참고.
#
# 참고: GitHub Actions 배포용 시크릿(VPS_HOST, VPS_USER, VPS_SSH_KEY)은 이 파일이
# 아니라 GitHub 저장소 Settings > Secrets and variables > Actions에 등록한다 (docs/CICD.md).
# =============================================================================

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=prod

# --- Backend Docker image (GHCR, 커밋 SHA 태그 — latest 금지) ---
# CI 배포 시 deploy.sh가 자동으로 export하므로 평소엔 비워둬도 된다.
# 수동으로 docker compose up 할 때만 배포할 커밋 SHA를 지정.
IMAGE_TAG=

# --- Database (postgres) ---
# DB_USERNAME/DB_PASSWORD는 새로 만든 임의 값 사용 (admin/1245 재사용 금지).
# 비밀번호 생성 예: openssl rand -base64 24
DB_NAME=halfspace
DB_USERNAME=change-me
DB_PASSWORD=change-me

# --- Redis ---
# 비워도 동작하지만 설정 권장. 생성 예: openssl rand -base64 24
REDIS_PASSWORD=

# --- JWT ---
# 32자(256bit) 이상 랜덤 문자열 필수. 생성 예: openssl rand -base64 48
JWT_SECRET=change-me-min-32-chars

# --- OAuth2 ---
# Google: https://console.cloud.google.com > API 및 서비스 > 사용자 인증 정보
#         > OAuth 클라이언트 ID 만들기 (웹 애플리케이션)
# Kakao:  https://developers.kakao.com > 내 애플리케이션 > 앱 키(REST API 키가
#         CLIENT_ID) + [보안] 탭에서 Client Secret 발급
# ⚠️ 각 콘솔에 redirect URL도 등록해야 한다 (백엔드 주소 기준):
#   https://<백엔드주소>/login/oauth2/code/google
#   https://<백엔드주소>/login/oauth2/code/kakao
# 상세 절차: docs/DEPLOY.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 로그인 성공 후 토큰을 전달할 프론트 콜백 URL (Vercel 프론트 주소 기준)
OAUTH2_REDIRECT_URI=https://<your-frontend>.vercel.app/oauth2/callback

# --- football-data.org (경기 데이터) ---
# https://www.football-data.org 무료 가입 시 이메일로 API 키 발급.
# 기존 키가 노출된 적 있다면 재발급할 것.
FOOTBALL_DATA_API_KEY=

# --- Gemini (AI 프리뷰/리뷰 생성) ---
# https://aistudio.google.com/apikey 에서 API 키 만들기.
# ⚠️ 없으면 football-agent가 즉시 종료되어 AI 프리뷰/리뷰 생성이 전부 실패한다.
GEMINI_API_KEY=

# --- Caddy (리버스 프록시 / 자동 HTTPS) ---
# 도메인 보유 시: 도메인 입력 (Caddy가 자동으로 HTTPS 인증서 발급).
# 도메인 미정 시: VPS 공인 IP 입력 — 단, IP로는 자동 HTTPS가 불가하므로
# 도메인 연결 전까지는 HTTP로 동작한다.
DOMAIN=your-domain.example

# --- Grafana (관측 대시보드) ---
# 첫 로그인: admin / 아래 비밀번호 (docs/DEPLOY.md §9)
GRAFANA_ADMIN_PASSWORD=change-me
# 디스코드 채널 설정 > 연동 > 웹훅 만들기 > URL 복사 (장애/배치 실패 알림용)
DISCORD_WEBHOOK_URL=

# --- CORS ---
# Vercel 배포 후 실제 프론트 주소로 교체. 여러 개면 콤마로 구분.
CORS_ALLOWED_ORIGINS=https://<your-frontend>.vercel.app
