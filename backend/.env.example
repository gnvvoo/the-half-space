# JWT
# HMAC-SHA256 서명 키. 32바이트 이상 랜덤 값을 base64로 인코딩해서 사용
# 생성 예: openssl rand -base64 32
JWT_SECRET=

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao OAuth2
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# football-data.org v4 API 키
FOOTBALL_DATA_API_KEY=

# OAuth2 Redirect (기본값: http://localhost:3000/oauth2/callback)
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth2/callback
